{
    "name": "4bdullatif/eudr-php-client",
    "description": "Framework-agnostic PHP client for the EU Deforestation Regulation (EUDR) API with WS-Security authentication",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "eudr",
        "eu-deforestation",
        "soap",
        "ws-security",
        "tracesnt",
        "european-commission",
        "php-client"
    ],
    "homepage": "https://github.com/4bdullatif/eudr-php-client",
    "support": {
        "issues": "https://github.com/4bdullatif/eudr-php-client/issues",
        "source": "https://github.com/4bdullatif/eudr-php-client"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*",
        "php": "^8.3",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0",
        "php-http/mock-client": "^1.6"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 HTTP client implementation",
        "symfony/http-client": "PSR-18 HTTP client implementation (with psr18 adapter)"
    },
    "autoload": {
        "psr-4": {
            "Eudr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eudr\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "coverage": "vendor/bin/phpunit --coverage-text",
        "check": [
            "@cs-check",
            "@analyse",
            "@test"
        ]
    }
}
